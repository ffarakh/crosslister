# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- App ---
APP_URL=http://localhost:3000
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- AI (Anthropic API, image-capable model) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- eBay (developer.ebay.com → Application Keys / User Tokens) ---
# "sandbox" for testing, "production" for real listings
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# RuName (the eBay Redirect URL name, NOT the URL itself). Its "accept URL" must be APP_URL/api/ebay/callback
EBAY_RUNAME=
